# Copy to .env and adjust. See README for backend details.
AI_BACKEND=stub

# "local" backend: an OpenAI-compatible server you run yourself
# (Ollama, llama.cpp server, vLLM). PHI never leaves your machine.
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_MODEL=llama3.1:8b

# "upstream" backend: any OpenAI-compatible provider.
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_MODEL=gpt-4o-mini
UPSTREAM_API_KEY=
